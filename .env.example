# Environment variables for production deployment
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Database configuration (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///app.db

# For PostgreSQL (if you want to use it instead of SQLite):
# DATABASE_URL=postgresql://username:password@localhost:5432/smart_grocery

# API URL for frontend (adjust based on your network setup)
VITE_API_URL=http://your-synology-ip:5000

# Optional: Set timezone
TZ=America/Los_Angeles
